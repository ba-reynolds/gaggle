# Resulting /srv/gaggle/.env on the EC2 box, written by deploy/apply.sh from
# GitHub Actions secrets at deploy time. Never commit real values.
DB_USER=gaggle
DB_PASSWORD=<from GAGGLE_DB_PASSWORD>
JWT_SECRET=<from GAGGLE_JWT_SECRET>
WEB_PORT=80
WEB_HTTPS_PORT=443
# Optional: set GAGGLE_HTTPS_DOMAIN (a GitHub secret, or edit /srv/gaggle/.env
# on the box) to a domain pointing at the box's public IP to provision a real
# Let's Encrypt cert via the certbot service. Leave empty to keep the
# self-signed fallback on 443. See README "HTTPS / TLS".
HTTPS_DOMAIN=