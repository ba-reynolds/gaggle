# Compose substitution variables (optional; defaults are shown).
# Copy to .env to override. These only drive docker compose; the API container
# gets its full config from compose (see compose.yaml `environment`).

# Postgres
DB_USER=white
DB_PASSWORD=teeth
DB_NAME=social
DB_PORT=6969

# Redis
REDIS_PORT=6379

# Web (nginx) host port
WEB_PORT=5173

# Production deploy: do NOT put real secrets here. They live as GitHub Actions
# secrets and are written to /srv/gaggle/.env on the EC2 box at deploy time
# (see README "Production deployment"). APP_ENV=production rejects these dev
# defaults at boot.

# API / auth
JWT_SECRET=dev-secret-change-me
