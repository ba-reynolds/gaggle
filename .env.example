# Compose substitution variables (optional; defaults are shown).
# Copy to .env to override. These only drive docker compose; the API container
# gets its full config from compose (see compose.yaml `environment`).

# Postgres
DB_USER=white
DB_PASSWORD=teeth
DB_NAME=social
DB_PORT=6969

# Redis
REDIS_PORT=6379

# Web (nginx) host ports
# WEB_PORT is the plain-HTTP host port (frontend). WEB_HTTPS_PORT is optional:
# when set to a host port (e.g. 443), the 443 TLS listener inside the web
# container is also published; leave empty (default) in local dev.
WEB_PORT=5173
# WEB_HTTPS_PORT=

# Production deploy: do NOT put real secrets here. They live as GitHub Actions
# secrets and are written to /srv/gaggle/.env on the EC2 box at deploy time
# (see README "Production deployment"). APP_ENV=production rejects these dev
# defaults at boot.
# On the box, WEB_PORT=80 and WEB_HTTPS_PORT=443 are set, and optionally
# HTTPS_DOMAIN=<your domain> to provision a real Let's Encrypt cert (see
# README "HTTPS / TLS").

# API / auth
JWT_SECRET=dev-secret-change-me

# Mail intake (x-orchid-secret): must match the Cloudflare Email Worker's
# INTAKE_SECRET and orchid's ORCHID_MAIL_SINK_TOKEN. Production sets this as
# the GAGGLE_INTAKE_SECRET GitHub Actions secret.
INTAKE_SECRET=dev-mail-intake-secret

# Google OAuth (optional). When set, the login/signup pages show a "Continue with Google" button.
# Create a project at https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI must match GOOGLE_REDIRECT_URL (default http://localhost:2021/api/v1/auth/google/callback for local dev)
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:2021/api/v1/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:5173
# Set to true to allow Google accounts with unverified emails (not recommended)
GOOGLE_ALLOW_UNVERIFIED_EMAIL=false
FRONTEND_URL=http://localhost:5173
